# Keep real values in .env.local. Never commit that file.
# U.S. stocks/ETFs and FX: https://twelvedata.com/
TWELVE_DATA_API_KEY=
# Crypto prices in EUR: https://www.coingecko.com/en/api
COINGECKO_DEMO_API_KEY=
# European stocks/ETFs (EOD / delayed): https://eodhd.com/
EODHD_API_KEY=

# Set to false only for a trusted HTTP-only local-network deployment.
# Keep the default (secure cookies) when serving the dashboard over HTTPS.
COOKIE_SECURE=
